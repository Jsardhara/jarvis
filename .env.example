# Jarvis env vars — copy to .env and fill in.
# .env is gitignored.

# ATLAS bridge
JARVIS_ATLAS_API=http://localhost:8000
# Bearer token injected into every ATLAS HTTP call (populated by atlas-devops gen_secrets.py)
ATLAS_BEARER_TOKEN=
# Atlas mode: "live" hits real API; "mock" never touches network
JARVIS_ATLAS_MODE=live
# Jarvis chat endpoint (Atlas terminal.py POSTs here)
JARVIS_CHAT_URL=http://localhost:8765/api/jarvis/terminal

# Project paths
JARVIS_PROJECT_ROOT=C:\Users\jyot2\jarvis
JARVIS_STATE_DIR=C:\Users\jyot2\jarvis\state

# Anthropic (Jarvis orchestrator + subsystems)
ANTHROPIC_API_KEY=

# Lens web research — first non-empty key wins.
# Brave: free 2000/mo, sign up at https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
# Perplexity: paid, https://perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Exa (legacy): paid, https://dashboard.exa.ai
EXA_API_KEY=

# Outlook / Microsoft Graph (Tempo integration)
# Azure app registration client_id (public client, delegated perms:
#   Mail.ReadWrite, Mail.Send, Calendars.ReadWrite, Tasks.ReadWrite, User.Read)
OUTLOOK_CLIENT_ID=
# Tenant: "consumers" (personal MS), "common" (both), or tenant GUID (work/school)
OUTLOOK_TENANT=consumers
# Override authority URL if you need a non-default endpoint
OUTLOOK_AUTHORITY=
# Token cache path (gitignored under state/)
OUTLOOK_TOKEN_CACHE=state/.msal_cache.json

# Apple iCloud (iCloud Mail + Calendar via IMAP/CalDAV)
APPLE_ID=
APPLE_APP_PASSWORD=

# Gmail (IMAP — enable "App Password" under Google Account security)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Drexel (OAuth2 — university SSO)
DREXEL_CLIENT_ID=
DREXEL_CLIENT_SECRET=
DREXEL_TENANT_ID=

# ── Phone access (Tailscale + PWA + ntfy) ──────────────────────────────────
# CORS origins that may hit FastAPI from the browser. Comma-separated.
# Add the tailnet hostname (run `tailscale status` to find yours).
# Example: JARVIS_CORS_ORIGINS=http://my-pc.tail-scale.ts.net:3000
JARVIS_CORS_ORIGINS=
# Or use a regex (covers all tailnet subdomains in one shot).
# JARVIS_CORS_REGEX=https?://.*\.ts\.net(:\d+)?

# ntfy.sh push (free, topic-based). Pick a long random topic — it is your only
# secret. Subscribe to the same topic in the ntfy mobile app.
# https://docs.ntfy.sh/subscribe/phone/
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
