# Jarvis env vars — copy to .env and fill in.
# .env is gitignored.

# ATLAS bridge
JARVIS_ATLAS_API=http://localhost:8000
# Bearer token injected into every ATLAS HTTP call (populated by atlas-devops gen_secrets.py)
ATLAS_BEARER_TOKEN=
# Atlas mode: "live" hits real API; "mock" never touches network
JARVIS_ATLAS_MODE=live
# Jarvis chat endpoint (Atlas terminal.py POSTs here)
JARVIS_CHAT_URL=http://localhost:8765/api/jarvis/terminal

# Project paths
JARVIS_PROJECT_ROOT=C:\Users\jyot2\jarvis
JARVIS_STATE_DIR=C:\Users\jyot2\jarvis\state

# Anthropic (Jarvis orchestrator + subsystems)
ANTHROPIC_API_KEY=

# Lens web research — first non-empty key wins.
# Brave: free 2000/mo, sign up at https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
# Perplexity: paid, https://perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Exa (legacy): paid, https://dashboard.exa.ai
EXA_API_KEY=

# Outlook / Microsoft Graph (Tempo integration)
# Azure app registration client_id (public client, delegated perms:
#   Mail.ReadWrite, Mail.Send, Calendars.ReadWrite, Tasks.ReadWrite, User.Read)
OUTLOOK_CLIENT_ID=
# Tenant: "consumers" (personal MS), "common" (both), or tenant GUID (work/school)
OUTLOOK_TENANT=consumers
# Override authority URL if you need a non-default endpoint
OUTLOOK_AUTHORITY=
# Token cache path (gitignored under state/)
OUTLOOK_TOKEN_CACHE=state/.msal_cache.json

# Apple iCloud (iCloud Mail + Calendar via IMAP/CalDAV)
APPLE_ID=
APPLE_APP_PASSWORD=
# Optional explicit CalDAV endpoint (auto-detected when omitted).
# Example: https://p123-caldav.icloud.com
APPLE_CALDAV_URL=

# Gmail (IMAP — enable "App Password" under Google Account security)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Drexel (OAuth2 — university SSO)
DREXEL_CLIENT_ID=
DREXEL_CLIENT_SECRET=
DREXEL_TENANT_ID=
# Domain on Drexel forwarded mail uses to identify university traffic.
DREXEL_FORWARD_DOMAIN=drexel.edu

# ── Phone access (Tailscale + PWA + ntfy) ──────────────────────────────────
# CORS origins that may hit FastAPI from the browser. Comma-separated.
# Add the tailnet hostname (run `tailscale status` to find yours).
# Example: JARVIS_CORS_ORIGINS=http://my-pc.tail-scale.ts.net:3000
JARVIS_CORS_ORIGINS=
# Or use a regex (covers all tailnet subdomains in one shot).
# JARVIS_CORS_REGEX=https?://.*\.ts\.net(:\d+)?

# ntfy.sh push (free, topic-based). Pick a long random topic — it is your only
# secret. Subscribe to the same topic in the ntfy mobile app.
# https://docs.ntfy.sh/subscribe/phone/
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Pushover (paid one-time, push to phone). Get keys at https://pushover.net/
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Slack (bot user OAuth + signing secret for inbound)
# Create at https://api.slack.com/apps → "Bots" + "Event Subscriptions".
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Discord bot (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Twilio (SMS / voice). https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ── Voice stack ────────────────────────────────────────────────────────────
# Master switch — set to 0 to disable the voice daemon entirely.
VOICE_ENABLED=1
# TTS provider: edge | piper | elevenlabs
VOICE_ENGINE_TTS=edge
# Voice name (depends on engine — for edge-tts: en-US-AndrewMultilingualNeural, etc.)
VOICE_NAME=en-US-AndrewMultilingualNeural
# Speech rate adjustment, e.g. "+0%", "+10%", "-5%"
VOICE_RATE=+0%

# Sentinel scheduler timezone (IANA name). Morning/evening cron jobs fire at
# 08:00/18:00 in this zone. Default = UTC (backward-compatible). Set to
# your local zone so "morning digest" fires at actual local 8am.
# Examples: America/New_York, Europe/London, Asia/Tokyo
JARVIS_TZ=

# Picovoice (wake-word detection — free dev tier covers a single keyword)
# https://picovoice.ai/
PICOVOICE_ACCESS_KEY=

# Deepgram (streaming STT, paid). https://deepgram.com/
DEEPGRAM_API_KEY=

# ElevenLabs (premium TTS voices). https://elevenlabs.io/
ELEVENLABS_API_KEY=

# MC API token — when set, all Next.js /api/* destructive calls require
#   `Authorization: Bearer <token>`. Leave blank for localhost-only dev;
#   middleware.ts still blocks non-loopback POST/PUT/PATCH/DELETE in that mode.
MC_API_TOKEN=
