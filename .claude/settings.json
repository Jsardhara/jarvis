{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Jarvis project â€” six runtime agents (jarvis+tempo+scholar+lens+forge+atlas) + dev-side team (jarvis-*). Multiple agents may run in parallel via Task tool.",

  "enabledMcpjsonServers": [
    "github",
    "exa",
    "context7",
    "memory",
    "sequential-thinking",
    "playwright",
    "claude-mem"
  ],

  "_pending_oauth": [
    "Outlook (MS Graph via MSAL device-code, not MCP)"
  ],

  "_jarvis_desktop_notes": {
    "_comment": "jarvis-desktop MCP gives full GUI control. Auto-allow ONLY read-only + non-destructive nav. Mutating tools prompt every time so operator approves in-context.",
    "auto_allowed_safe": [
      "desktop_screenshot",
      "desktop_list_windows",
      "desktop_get_mouse_position",
      "desktop_get_screen_size",
      "desktop_move_mouse",
      "desktop_focus_window"
    ],
    "prompt_each_time": [
      "desktop_click",
      "desktop_double_click",
      "desktop_right_click",
      "desktop_drag",
      "desktop_type",
      "desktop_press_key",
      "desktop_scroll"
    ],
    "how_to_widen": "If a task needs a mutating tool repeatedly, either (a) approve once via 'always allow' on prompt, (b) add specific tool to permissions.allow above (e.g. 'mcp__jarvis-desktop__desktop_click'), or (c) blanket 'mcp__jarvis-desktop__*' for full trust mode.",
    "how_to_revoke": "Remove tool from permissions.allow and restart session."
  },

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Agent",
      "TaskCreate",
      "TaskList",
      "TaskUpdate",
      "TaskGet",
      "TaskOutput",
      "TaskStop",
      "Skill",
      "WebFetch",
      "WebSearch",

      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python -m jarvis.*)",
      "Bash(python -c *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pip install *)",
      "Bash(uvicorn *)",

      "Bash(bun *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",

      "Bash(git status)",
      "Bash(git status -s)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",

      "Bash(gh *)",

      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s http://localhost:*)",

      "Bash(ls *)",
      "Bash(cat state/*)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(netstat *)",
      "Bash(tasklist *)",

      "Bash(taskkill *)",
      "Bash(rm -f *)",

      "mcp__plugin_ecc_github__*",
      "mcp__plugin_ecc_exa__*",
      "mcp__plugin_ecc_context7__*",
      "mcp__plugin_ecc_memory__*",
      "mcp__plugin_ecc_sequential-thinking__*",
      "mcp__plugin_ecc_playwright__*",

      "mcp__jarvis-desktop__desktop_screenshot",
      "mcp__jarvis-desktop__desktop_list_windows",
      "mcp__jarvis-desktop__desktop_get_mouse_position",
      "mcp__jarvis-desktop__desktop_get_screen_size",
      "mcp__jarvis-desktop__desktop_move_mouse",
      "mcp__jarvis-desktop__desktop_focus_window"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard origin/*)",
      "Edit(C:\\Users\\jyot2\\atlas\\**)",
      "Write(C:\\Users\\jyot2\\atlas\\**)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_start_inbox.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check --fix --quiet jarvis/ tests/ 2>/dev/null || true"
          }
        ]
      }
    ]
  },

  "env": {
    "JARVIS_PROJECT_ROOT": "C:\\Users\\jyot2\\jarvis",
    "JARVIS_STATE_DIR": "C:\\Users\\jyot2\\jarvis\\state",
    "JARVIS_ATLAS_API": "http://localhost:8000",
    "PYTHONIOENCODING": "utf-8",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },

  "teammateMode": "in-process",

  "_agent_team": {
    "_comment": "Dev-side agents the operator spawns via Task tool to parallelize work on Jarvis itself. Runtime subsystem agents (tempo/scholar/lens/forge/atlas) are different â€” those are dispatched by jarvis orchestrator at runtime.",
    "runtime_agents": [
      "jarvis",
      "tempo",
      "scholar",
      "lens",
      "forge",
      "atlas"
    ],
    "dev_team": [
      "jarvis-backend-dev",
      "jarvis-frontend-dev",
      "jarvis-test-runner",
      "jarvis-dashboard-designer",
      "jarvis-outlook-integrator"
    ],
    "parallel_safe_combinations": [
      ["jarvis-backend-dev", "jarvis-frontend-dev"],
      ["jarvis-backend-dev", "jarvis-frontend-dev", "jarvis-test-runner"],
      ["jarvis-dashboard-designer", "jarvis-backend-dev"],
      ["jarvis-outlook-integrator", "jarvis-frontend-dev", "jarvis-test-runner"]
    ],
    "scope_boundaries": {
      "jarvis-backend-dev": "jarvis/ + tests/ (read-only on web/, atlas/)",
      "jarvis-frontend-dev": "web/src/ (read-only on jarvis/)",
      "jarvis-test-runner": "tests/ + minimal jarvis/ for genuine bugs",
      "jarvis-dashboard-designer": "web/src/app/globals.css + component proposals",
      "jarvis-outlook-integrator": "jarvis/agents/tempo/providers/ + integration points"
    }
  }
}

