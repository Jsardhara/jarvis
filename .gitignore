# State + secrets
# Anchor `state/` to the repo root so it ignores ./state/ (runtime data) but
# does NOT match jarvis/state/ (the persistence-layer Python package).
/state/
# Dashboard runtime data — contains operator PII (inbox messages, decisions,
# brain-dump entries). Must NOT be committed. The `web/data/` directory itself
# is preserved via web/data/.gitkeep so first-boot writes succeed.
/web/data/
!/web/data/.gitkeep
.env
.env.local
*.secret
*.key

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Node / web
node_modules/
.next/
dist/
build/

# Voice runtime — anchored so it doesn't shadow jarvis/apps/voice/ source.
/voice/models/
/voice/recordings/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Daemon runtime
*.pid
*.log
.forge-worktrees/

# pnpm install temp leftovers
_tmp_*
jarvis.egg-info/
