[Unit]
Description=Ollama serving sidecar models (sentinel 7B + vision + embeddings)
Documentation=file://@JARVIS_ROOT@/docs/JARVIS_2026_ROADMAP.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=-%h/.config/jarvis/env
Environment=OLLAMA_HOST=127.0.0.1:11434
ExecStart=@OLLAMA@ serve
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.local/share/jarvis/logs/ollama.log
StandardError=append:%h/.local/share/jarvis/logs/ollama.err

[Install]
WantedBy=default.target
