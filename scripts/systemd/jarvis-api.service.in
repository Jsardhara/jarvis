[Unit]
Description=Jarvis API server (FastAPI)
Documentation=file://@JARVIS_ROOT@/docs/JARVIS_2026_ROADMAP.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@JARVIS_ROOT@
EnvironmentFile=-@JARVIS_ROOT@/.env
EnvironmentFile=-%h/.config/jarvis/env
ExecStart=@PYTHON@ -m uvicorn jarvis.apps.api.app:app --host 0.0.0.0 --port @API_PORT@
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.local/share/jarvis/logs/api.log
StandardError=append:%h/.local/share/jarvis/logs/api.err

[Install]
WantedBy=default.target
