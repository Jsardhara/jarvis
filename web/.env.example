# Mission Control Environment Variables
# Copy this file to .env.local and fill in values as needed.

# ─── API Authentication ─────────────────────────────────────────────────────
# Set a secret token to protect API endpoints from unauthorized access.
# When not set, all API requests pass through (suitable for localhost-only use).
#
# Generate a token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Both variables must match. MC_API_TOKEN is used server-side (middleware),
# NEXT_PUBLIC_MC_API_TOKEN is used client-side (browser fetch calls).
#
# MC_API_TOKEN=your-secret-token-here
# NEXT_PUBLIC_MC_API_TOKEN=your-secret-token-here

# ─── Backend (FastAPI) origin ──────────────────────────────────────────────
# When the dashboard is served from a non-localhost origin (tailnet, LAN),
# the browser must hit FastAPI directly via this URL for SSE/WS streams.
#
# Examples:
#   NEXT_PUBLIC_JARVIS_API=http://my-pc.tailnet-name.ts.net:8765
#   NEXT_PUBLIC_JARVIS_API=http://192.168.1.42:8765
# NEXT_PUBLIC_JARVIS_API=http://localhost:8765

# ─── LAN / tailnet dev origins ─────────────────────────────────────────────
# Comma-separated extra origins Next.js trusts during dev mode.
# JARVIS_DEV_ORIGINS=http://my-pc.tailnet-name.ts.net:3000,http://192.168.1.42:3000

# ─── Future ─────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=
# DATABASE_URL=
